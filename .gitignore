# Unpublished manuscripts live outside the repo, at
# ~/Documents/manuscripts/acje.github.io/book (see docs/manuscripts.md).
# Git does not hold or back them up; keep the external tarball.
# This overlay previews them locally and deploy builds never load it.
hugo.local.yaml

# Safety net: accidental in-repo copies of the unpublished manuscripts
# must never become committable.
content/book/
/graphify-out/
